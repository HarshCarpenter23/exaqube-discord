# Copy to .env and fill in. The backend fails to start if a required value is missing.

# --- Database ---------------------------------------------------------------
# App role: read/write on app-owned tables (e.g. pinned charts). Used by the API.
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
# Read-only role: the ONLY role the agent's SQL runs as. Enforced at the database.
READONLY_DATABASE_URL=postgresql+asyncpg://agent_ro:agent_ro_pw@db:5432/app
# Password the migration uses when creating the read-only role (must match the URL above).
AGENT_RO_PASSWORD=agent_ro_pw

# Postgres container credentials (used by docker-compose to init the DB).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- LLM provider -----------------------------------------------------------
# Which provider implementation to use. Default: groq (OpenAI-compatible).
LLM_PROVIDER=groq
# Best free-tier model for agentic tool use. Lighter fallback: openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-120b
# Put your Groq key here. This is the only thing needed to run the agent.
GROQ_API_KEY=
# Keep responses bounded to respect the free-tier 8k tokens/minute limit.
LLM_MAX_COMPLETION_TOKENS=1024
RESULT_PREVIEW_ROWS=15

# --- Agent behaviour --------------------------------------------------------
AGENT_MAX_STEPS=6
AGENT_MAX_RETRIES=2

# --- Safety limits ----------------------------------------------------------
ROW_CAP=5000
STATEMENT_TIMEOUT_MS=5000
ARTIFACT_DIR=/artifacts
ARTIFACT_MAX_ROWS=50000
ARTIFACT_MAX_BYTES=10485760
PPTX_MAX_SLIDES=20

# --- Data load --------------------------------------------------------------
# Where the dataset CSVs live inside the container (mounted from ./data/dataset).
DATA_DIR=/data/dataset

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
